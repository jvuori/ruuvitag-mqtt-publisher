[Unit]
Description=RuuviTag MQTT Publisher
After=network-online.target mosquitto.service bluetooth.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Restart=on-failure
RestartSec=30
Environment="PYTHONPATH=/srv/ruuvitag-mqtt-publisher"
ExecStart=python3 -m ruuvitag_mqtt -c /etc/ruuvitag-mqtt.json

[Install]
WantedBy=multi-user.target
